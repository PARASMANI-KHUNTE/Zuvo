# Worker Service Config (background tasks: fan-out, email, media, GDPR)
NODE_ENV=development
DB_NAME=Zuvo
MONGODB_URI=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379
HEALTH_PORT=8010

# Internal service URLs
AUTH_INTERNAL_URL=http://127.0.0.1:8000
MEDIA_INTERNAL_URL=http://127.0.0.1:8003
BLOG_INTERNAL_URL=http://127.0.0.1:8001
INTERACTIONS_INTERNAL_URL=http://127.0.0.1:8002

# Frontend base URL (used in email links)
FRONTEND_URL=http://localhost:3000

# Secrets (generate your own — do not reuse across environments)
JWT_SECRET=your_jwt_secret
ACCESS_TOKEN_SECRET=your_access_token_secret

# Email delivery (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=Zuvo <noreply@zuvo.com>

# Tracing
JAEGER_ENDPOINT=http://localhost:4317
