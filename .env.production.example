# =================================================================
# Zuvo Production Environment Configuration
# Copy this file to .env on your server and update the values
# =================================================================

# -------------------------------------------------------------
# Domain & Networking
# -------------------------------------------------------------
DOMAIN=yourdomain.com
CORS_ORIGIN=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
NEXT_PUBLIC_REALTIME_URL=https://yourdomain.com

# -------------------------------------------------------------
# Database & Cache (Leave as-is if using Docker Compose services)
# If using MongoDB Atlas or Redis Cloud, replace with your remote connection URIs
# -------------------------------------------------------------
DB_NAME=Zuvo
MONGODB_URI=mongodb://mongodb:27017/Zuvo
REDIS_URL=redis://redis:6379

# -------------------------------------------------------------
# Security & JWT Tokens (Generate strong random 64-char strings)
# e.g., openssl rand -hex 32
# -------------------------------------------------------------
JWT_SECRET=replace_with_a_super_secret_jwt_key_at_least_32_chars
ACCESS_TOKEN_SECRET=replace_with_a_super_secret_access_token_key_at_least_32_chars
REFRESH_TOKEN_SECRET=replace_with_a_super_secret_refresh_token_key_at_least_32_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# -------------------------------------------------------------
# Cloudinary (Required for image & video uploads)
# Obtain from https://cloudinary.com/console
# -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -------------------------------------------------------------
# Google OAuth 2.0 (Required for Google Login)
# Obtain from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://yourdomain.com/api/v1/auth/google/callback
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/v1/auth/google/callback

# -------------------------------------------------------------
# SMTP / Email Service (For email verification & OTP)
# -------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=Zuvo <noreply@yourdomain.com>
