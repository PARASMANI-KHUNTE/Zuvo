# API Gateway URL (backend entry point)
# For Android emulator use: http://10.0.2.2:5000
# For iOS simulator use: http://localhost:5000
# For physical device use your machine's LAN IP: http://192.168.x.x:5000
EXPO_PUBLIC_API_URL=http://localhost:5000

# Realtime WebSocket URL (goes through gateway)
# Same platform considerations as API_URL above
EXPO_PUBLIC_REALTIME_URL=http://localhost:5000
